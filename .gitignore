# Build outputs
/target/
node_modules/

# wasm-bindgen output. Regenerated by `make wasm`; the Dockerfile builds its own
# copy, and .dockerignore excludes it so the host's build cannot leak into the
# image and be mistaken for one the container produced.
/tests/original/pkg/
/web/pkg/

# Generated demo bundle (1.5 MB, wasm inlined as base64). Rebuild with
# `node scripts/build-demo.mjs`.
/web/tinycolor.js

# Fuzz output. The archived headline runs ARE committed as evidence -- see the
# negations below. Everything else is scratch.
/fuzz/logs/*
!/fuzz/logs/run-wasm-300s-seed1.log
!/fuzz/logs/run-wasm-300s-seed1.json
!/fuzz/logs/run-native-120s-seed11.log
!/fuzz/logs/run-native-120s-seed11.json

# macOS
.DS_Store

# Editor
.idea/
*.swp
